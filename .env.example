# Copy to .env and fill in. .env is gitignored.

# Bundle identifier for the iOS app. Must be unique. See docs/IPHONE.md#values-in-env
IOS_BUNDLE_ID=com.yourname.IosShell

# Signing team ID of the Apple ID. How to find it: docs/IPHONE.md#values-in-env
# Leave empty to let Xcode choose the team.
APPLE_TEAM_ID=

# Optional. Shown on the Info tab. Passed to the app as Constants.expoConfig.extra.username
username=

# Time zone for the build time shown on the Info tab, e.g. Europe/Bucharest.
# Empty = this Mac's time zone. Notifications use the phone's own time zone.
APP_TIMEZONE=
