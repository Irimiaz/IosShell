# Copy to .env and fill in. .env is gitignored.

# Bundle identifier for the iOS app. Must be unique. See scripts/build/env.md
IOS_BUNDLE_ID=com.yourname.IosShell

# Signing team ID of the Apple ID. How to find it: scripts/build/env.md
# Leave empty to let Xcode choose the team.
APPLE_TEAM_ID=

# Passed to the app as Constants.expoConfig.extra.username
username=
